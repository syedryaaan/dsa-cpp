#include <iostream>
#include <vector>
using namespace std ;

int main (){
  int N;
  cin >> N;
  if (N <= 0) {
    return 0;
  }

  vector<int> arr(N);
  vector<int> dp(N, 0);
   
  for(int i = 0; i < N; i++){
    cin >> arr[i];
  }

  dp[0] = 0;
  for(int i = 1; i < N; i++){
    int diff = arr[i] - arr[i-1];
    if(diff < 0) diff = -diff;
    dp[i] = dp[i-1] + diff;
  }

  cout << dp[N-1] << endl;
  
  
  
  
  
  
  
  return 0;
}
