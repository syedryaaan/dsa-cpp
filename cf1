#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int arr[100];

        for (int i = 0; i < n; i++) {
            cin >> arr[i];
        }

        long long ans = 0;
        int mn = arr[0];

        for (int i = 0; i < n; i++) {
            if (arr[i] < mn) {
                mn = arr[i];
            }

            ans += mn;
        }

        cout << ans << endl;
    }

    return 0;
}
